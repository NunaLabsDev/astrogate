{
  // AstroGate Frontend + Telegram Bot Webhook Worker on Cloudflare Workers.
  // Static SPA routes fall back to index.html via ASSETS binding.
  "$schema": "node_modules/wrangler/config_schema.json",
  "name": "astrogate-stellar",
  "main": "worker/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TELEGRAM_COMMUNITY_CHAT_ID": "-1001625368092",
    "TELEGRAM_FEED_CHAT_ID": "-1003912502880",
    "TELEGRAM_FOLDER_URL": "https://t.me/addlist/dyMTkV2uU6hmYzE0"
  },
  "kv_namespaces": [
    {
      "binding": "ASTRO_KV",
      "id": "4e9766f1e476477bb1191f07f9a3c25f"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  }
}
