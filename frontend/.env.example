# Red Stellar activa (testnet por defecto; mainnet requiere contratos desplegados en mainnet).
VITE_STELLAR_NETWORK=testnet

# WalletConnect v2 (opcional): habilita wallets móviles (Freighter Mobile,
# xBull móvil…) vía QR usando el módulo de la kit.
# 1) Crea un proyecto gratis en https://cloud.reown.com
# 2) Copia su projectId aquí y vuelve a desplegar.
# Sin esta variable, la app funciona igual con las wallets de escritorio.
VITE_WC_PROJECT_ID=

# Dominio público del despliegue, sin protocolo y sin path (opcional).
# Se usa para la URL web autocolocada en los metadatos de los tokens creados.
# Ej.: VITE_SITE_ORIGIN=astrogate.example.com
VITE_SITE_ORIGIN=

# Cuenta oficial del treasury developer (opcional; sobrescribe el default de testnet).
VITE_DEVELOPER_TREASURY_ADDRESS=GDQT2KMQ5I2EFDK3WG42YBHRIC4B7OXL7K2G3IC2Z6LPTJEEOMXD7NQE

# Overrides opcionales de RPC / Horizon / contratos (utiles para mainnet o RPC dedicado).
VITE_SOROBAN_RPC_URL=
VITE_HORIZON_URL=
VITE_LAUNCHPAD_CONTRACT_ID=
VITE_SOROBITS_CONTRACT_ID=

# Webhook HTTPS público de alertas de lanzamiento/ballena/graduación (opcional).
VITE_ALERT_WEBHOOK_URL=

# Integración del Ecosistema ASTRO (AstroWallet AstroID SSO + AstroDex Terminal)
VITE_ASTROWALLET_API_BASE_URL=
VITE_ASTROWALLET_BOT_USERNAME=AstroWalletAppBot
VITE_ASTROWALLET_MINI_APP_SHORT_NAME=wallet
VITE_ASTRODEX_BOT_USERNAME=AstroDexBot
VITE_ASTRODEX_MINI_APP_SHORT_NAME=dex
