{
  "name": "AstroGate Soroban & Frontend Audit Sandbox",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "default"
    }
  },
  "postCreateCommand": "rustup component add rustfmt clippy && rustup target add wasm32v1-none && cd frontend && npm ci",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "AstroGate Vite Dev Server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "GitHub.copilot"
      ]
    }
  }
}
